{
  "name": "currency-converter-app",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "test": "vitest",
    "test:ci": "vitest run --config vite.config.ts",
    "test:coverage": "vitest run --config vite.config.ts --coverage",
    "test:browser": "vitest --config vite.browser.config.ts",
    "test:playwright": "playwright test",
    "test:playwright:ui": "playwright test --ui",
    "test:playwright:chromium": "playwright test --project=chromium",
    "test:playwright:install": "playwright install chromium",
    "lint": "eslint --max-warnings 0",
    "typecheck": "react-router typegen && tsc"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "parserPreset": {
      "parserOpts": {
        "headerPattern": "^(feat|fix|release|chore|docs|ci|build)\\(([A-Za-z0-9-]+)\\): (.+)$",
        "headerCorrespondence": [
          "type",
          "scope",
          "subject"
        ]
      }
    },
    "rules": {
      "type-enum": [
        2,
        "always",
        [
          "feat",
          "fix",
          "release",
          "chore"
        ]
      ],
      "scope-empty": [
        2,
        "never"
      ],
      "header-max-length": [
        2,
        "always",
        100
      ],
      "subject-empty": [
        2,
        "never"
      ]
    }
  },
  "browserslist": [
    "defaults",
    "Safari >= 17",
    "iOS >= 17"
  ],
  "engines": {
    "node": ">=24",
    "pnpm": ">=12"
  },
  "packageManager": "pnpm@12.5.1",
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@react-router/node": "7.13.1",
    "@react-router/serve": "7.13.1",
    "@tanstack/react-query": "5.91.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@vitest/browser-playwright": "^5.0.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.2",
    "decimal.js": "^10.6.0",
    "isbot": "^5.1.36",
    "lucide-react": "^1.47.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "7.13.1",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@commitlint/cli": "20.4.2",
    "@commitlint/config-conventional": "20.4.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@react-router/dev": "7.13.1",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "5.0.1",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint": "^10.11.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "husky": "9.1.7",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "lint-staged": "^16.2.4",
    "msw": "^2.15.0",
    "prettier": "^3.7.4",
    "prettier-plugin-space-before-function-paren": "^0.0.10",
    "rollup-plugin-visualizer": "^7.0.1",
    "stylelint-config-tailwindcss": "1.0.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.1",
    "vite": "8.3.0",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "^5.0.1",
    "zod": "4.6.5"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
